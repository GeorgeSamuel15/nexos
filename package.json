{
  "name": "nexos",
  "version": "0.2.3",
  "private": true,
  "description": "NexOS — a secure, modular TypeScript desktop operating environment",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm run build:packages && pnpm --filter @nexos/desktop dev",
    "build:packages": "pnpm --filter=./packages/** --filter=@nexos/system-service build",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build && playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm run build:packages && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "pnpm run build && pnpm --filter @nexos/desktop package",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  }
}
